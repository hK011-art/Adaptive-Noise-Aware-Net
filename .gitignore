# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE & Editor settings
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Raw large dataset contents (keep directory structure via .gitkeep)
data/div2k/*
!data/div2k/.gitkeep
data/sidd/*
!data/sidd/.gitkeep
data/dnd/*
!data/dnd/.gitkeep

# Ephemeral test outputs
tests/*.pth
tests/*_tmp.pth

